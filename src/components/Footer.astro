---
import { Image } from "astro:assets";
import logo from "../assets/logo.png";
const { t, basePath = "" } = Astro.props;
const currentYear = new Date().getFullYear();
const buildPath = (path: string) => {
  if (!basePath) return path;
  return path === "/" ? basePath : `${basePath}${path}`;
};
---

<footer class="footer">
  <div class="container footer-inner">
    <div class="footer-brand">
      <div class="footer-logo-wrap">
        <Image src={logo} alt={t.footer.logoAlt ?? "Kiddos Events logo"} loading="eager" />
      </div>
      <p class="footer-tagline">
       {t.footer.tagline}
      </p>
    </div>

    <div class="footer-links">
      <h4>{t.footer.navTitle}</h4>
      <ul role="list">
        <li><a href={buildPath("/")}>{t.footer.navLinks.home}</a></li>
        <li><a href={buildPath("/vjencanja")}>{t.footer.navLinks.weddings}</a></li>
        <li><a href={buildPath("/proslave-i-eventi")}>{t.footer.navLinks.events}</a></li>
        <li><a href={buildPath("/najam-opreme")}>{t.footer.navLinks.rental}</a></li>
      </ul>
    </div>

    <div class="footer-contact">
      <h4>{t.footer.contactTitle}</h4>
      <ul role="list">
        <li>
          <a href="mailto:kontakt@kiddos-events.hr">kontakt@kiddos-events.hr</a>
        </li>
      </ul>
      <div class="social-buttons">
        <a
          href="https://instagram.com/kiddosevents"
          target="_blank"
          rel="noopener noreferrer"
          class="social-btn"
          aria-label={t.footer.socialAria.instagram}
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
            <circle cx="12" cy="12" r="4"></circle>
            <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"></circle>
          </svg>
          {t.footer.socialLabels.instagram}
        </a>
        <a
          href="https://www.facebook.com/profile.php?id=61566598790046"
          target="_blank"
          rel="noopener noreferrer"
          class="social-btn"
          aria-label={t.footer.socialAria.facebook}
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path>
          </svg>
          {t.footer.socialLabels.facebook}
        </a>
      </div>
      <p class="footer-meta">{t.footer.meta}</p>
    </div>
  </div>

  <div class="container footer-bottom">
    <p>&copy; {currentYear} {t.footer.copyright}</p>
    <nav class="footer-legal" aria-label={t.footer.legalLabel}>
      <a href={buildPath("/opci-uvjeti")}>{t.footer.legalLinks.terms}</a>
      <span aria-hidden="true">·</span>
      <a href={buildPath("/politika-privatnosti")}>{t.footer.legalLinks.privacy}</a>
    </nav>
  </div>
</footer>

<style>
  .footer {
    background-color: var(--dark);
    color: var(--paper);
    padding: 76px 0 0;
  }

  .footer-inner {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr;
    gap: 40px;
    padding-bottom: 48px;
    border-bottom: 1px solid rgba(245, 242, 237, 0.14);
  }

  .footer-logo-wrap {
    width: clamp(108px, 9vw, 138px);
    aspect-ratio: 2.55 / 1;
    overflow: hidden;
    margin-bottom: 16px;
  }

  .footer-logo-wrap :global(img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: left center;
    background-color: transparent;
    opacity: 1;
  }

  .footer-logo-wrap :global(picture) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .footer-tagline {
    font-size: 0.96rem;
    line-height: 1.6;
    max-width: 320px;
    color: rgba(245, 242, 237, 0.75);
  }

  .footer h4 {
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--paper);
    margin-bottom: 16px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .footer ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .footer a {
    font-size: 0.9rem;
    color: rgba(245, 242, 237, 0.75);
    transition: color 0.2s ease, opacity 0.2s ease;
  }

  .footer a:hover {
    color: var(--paper);
    opacity: 1;
  }

  .social-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 18px;
  }

  .social-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 14px;
    border-radius: 6px;
    border: 1px solid rgba(245, 242, 237, 0.2);
    font-size: 0.84rem;
    font-weight: 600;
    color: var(--paper);
    background: transparent;
    transition: opacity 0.2s ease, border-color 0.2s ease, background-color 0.2s ease;
  }

  .social-btn:hover,
  .social-btn:focus-visible {
    background: rgba(245, 242, 237, 0.08);
    border-color: rgba(245, 242, 237, 0.4);
    color: var(--paper);
    opacity: 1;
  }

  .footer-bottom {
    padding: 20px 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
  }

  .footer-bottom p {
    font-size: 0.82rem;
    color: rgba(245, 242, 237, 0.55);
  }

  .footer-legal {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .footer-legal a {
    font-size: 0.82rem;
    color: rgba(245, 242, 237, 0.55);
    transition: color 0.2s ease, opacity 0.2s ease;
  }

  .footer-legal a:hover {
    color: var(--paper);
  }

  .footer-legal span {
    font-size: 0.82rem;
    color: rgba(245, 242, 237, 0.35);
  }

  .footer-meta {
    margin-top: 14px;
    font-size: 0.84rem;
    color: rgba(245, 242, 237, 0.6);
    max-width: none;
    line-height: 1.5;
  }

  @media (max-width: 900px) {
    .footer-inner {
      grid-template-columns: 1fr;
      gap: 28px;
    }
  }

  @media (max-width: 768px) {
    .footer {
      padding-top: 56px;
    }

    .footer-bottom {
      flex-direction: column;
      align-items: flex-start;
      gap: 8px;
      margin-top: 16px;
      padding-bottom: 22px;
    }
  }
</style>
