---
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';
const currentYear = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer-inner">
    <div class="footer-brand">
      <Image src={logo} alt="Kiddos Events logo" width={120} height={52} loading="lazy" />
      <p class="footer-tagline">
        Stvaramo nezaboravne trenutke za vaše mališane.
      </p>
    </div>

    <div class="footer-links">
      <h4>Navigacija</h4>
      <ul role="list">
        <li><a href="/o-nama">O nama</a></li>
        <li><a href="/galerija">Galerija</a></li>
        <li><a href="/usluge">Usluge</a></li>
      </ul>
    </div>

    <div class="footer-contact">
      <h4>Kontakt</h4>
      <ul role="list">
        <li>
          <a href="mailto:kontakt@kiddos-events.hr">kontakt@kiddos-events.hr</a>
        </li>
      </ul>
      <div class="social-buttons">
        <a
          href="https://instagram.com/kiddosevents"
          target="_blank"
          rel="noopener noreferrer"
          class="social-btn social-btn--instagram"
          aria-label="Pratite nas na Instagramu"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
            <circle cx="12" cy="12" r="4"/>
            <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/>
          </svg>
          Instagram
        </a>
        <a
          href="https://www.facebook.com/profile.php?id=61566598790046"
          target="_blank"
          rel="noopener noreferrer"
          class="social-btn social-btn--facebook"
          aria-label="Pratite nas na Facebooku"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/>
          </svg>
          Facebook
        </a>
      </div>
    </div>
  </div>

  <div class="container footer-bottom">
    <p>&copy; {currentYear} Kiddos Events. Sva prava pridržana.</p>
    <nav class="footer-legal" aria-label="Pravni dokumenti">
      <a href="/opci-uvjeti">Opći uvjeti korištenja</a>
      <span aria-hidden="true">·</span>
      <a href="/politika-privatnosti">Politika privatnosti</a>
    </nav>
  </div>
</footer>

<style>
  .footer {
    background-color: var(--dark);
    color: rgba(253, 251, 247, 0.7);
    padding: 64px 0 0;
  }

  .footer-inner {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr;
    gap: 48px;
    padding-bottom: 48px;
    border-bottom: 1px solid rgba(253, 251, 247, 0.1);
  }

  .footer-brand :global(img) {
    height: 40px;
    width: auto;
    margin-bottom: 16px;
    opacity: 0.9;
  }

  .footer-tagline {
    font-size: 0.9rem;
    line-height: 1.6;
    max-width: 280px;
  }

  .footer h4 {
    font-family: var(--font-body);
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--cream);
    margin-bottom: 16px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .footer ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .footer a {
    font-size: 0.875rem;
    color: rgba(253, 251, 247, 0.6);
    transition: color 0.2s ease;
  }

  .footer a:hover {
    color: var(--cream);
  }

  .footer-bottom {
    padding: 20px 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
  }

  .footer-bottom p {
    font-size: 0.8rem;
    color: rgba(253, 251, 247, 0.4);
  }

  .footer-legal {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .footer-legal a {
    font-size: 0.8rem;
    color: rgba(253, 251, 247, 0.35);
    transition: color 0.2s ease;
  }

  .footer-legal a:hover {
    color: rgba(253, 251, 247, 0.7);
  }

  .footer-legal span {
    font-size: 0.8rem;
    color: rgba(253, 251, 247, 0.2);
  }

  .social-buttons {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-top: 16px;
  }

  .social-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 16px;
    border-radius: 999px;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    border: 1.5px solid transparent;
    width: fit-content;
    transition: color 0.2s ease, background-color 0.2s ease, border-color 0.2s ease;
  }

  .social-btn--instagram {
    color: var(--soft-pink);
    border-color: rgba(242, 190, 206, 0.35);
    background-color: rgba(242, 190, 206, 0.08);
  }

  .social-btn--instagram:hover {
    background-color: rgba(242, 190, 206, 0.18);
    border-color: rgba(242, 190, 206, 0.65);
    color: #f9d4e0;
  }

  .social-btn--facebook {
    color: var(--sky-blue);
    border-color: rgba(141, 216, 236, 0.35);
    background-color: rgba(141, 216, 236, 0.08);
  }

  .social-btn--facebook:hover {
    background-color: rgba(141, 216, 236, 0.18);
    border-color: rgba(141, 216, 236, 0.65);
    color: #b0e5f3;
  }

  @media (max-width: 768px) {
    .footer-inner {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }
</style>
