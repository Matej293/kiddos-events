---
import { Image } from "astro:assets";
import logo from "../assets/logo.png";

const { t, basePath = "" } = Astro.props;
const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const normalizePath = (path: string) => path.replace(/\/$/, "") || "/";
const buildPath = (path: string) => {
  if (!basePath) return path;
  return path === "/" ? basePath : `${basePath}${path}`;
};
const isActive = (path: string) => normalizePath(currentPath) === normalizePath(buildPath(path));
const isEnglish = currentPath.startsWith("/en");
const hrPath = isEnglish ? currentPath.replace(/^\/en(\/|$)/, "/") || "/" : currentPath;
const enPath = isEnglish ? currentPath : `/en${currentPath === "/" ? "" : currentPath}`;
---

<header class="nav-header">
  <nav class="container nav-inner" aria-label={t.nav.ariaLabel}>
    <a href={buildPath("/")} class="nav-logo" aria-label={t.nav.logoLabel}>
      <Image src={logo} alt={t.nav.logoAlt ?? t.nav.logoLabel} loading="eager" />
    </a>

    <input type="checkbox" id="mobile-menu-toggle" class="mobile-toggle-input" aria-hidden="true" />
    <button type="button" class="mobile-menu-btn" aria-label={t.nav.menuOpen}>
      <span class="hamburger-line"></span>
      <span class="hamburger-line"></span>
      <span class="hamburger-line"></span>
    </button>

    <ul class="nav-links" role="list">
      <li>
        <a href={buildPath("/")} class:list={["nav-link", { active: isActive("/") }]}>
          {t.nav.links.home}
        </a>
      </li>
      <li>
        <a href={buildPath("/vjencanja")} class:list={["nav-link", { active: isActive("/vjencanja") }]}>
          {t.nav.links.weddings}
        </a>
      </li>
      <li>
        <a
          href={buildPath("/proslave-i-eventi")}
          class:list={["nav-link", { active: isActive("/proslave-i-eventi") }]}
        >
          {t.nav.links.events}
        </a>
      </li>
      <li>
        <a href={buildPath("/najam-opreme")} class:list={["nav-link", { active: isActive("/najam-opreme") }]}>
          {t.nav.links.rental}
        </a>
      </li>
    </ul>

    <button type="button" class="btn-primary nav-cta" data-contact-open>
      {t.nav.contact}
    </button>

    <div class="nav-lang" aria-label={t.nav.languageLabel}>
      <a href={hrPath} class:list={["lang-link", { active: !isEnglish }]} aria-current={!isEnglish ? "page" : undefined}>
        {t.nav.languageHr}
      </a>
      <span class="lang-divider" aria-hidden="true">/</span>
      <a href={enPath} class:list={["lang-link", { active: isEnglish }]} aria-current={isEnglish ? "page" : undefined}>
        {t.nav.languageEn}
      </a>
    </div>

    <div class="mobile-nav">
      <ul role="list">
        <li>
          <a href={buildPath("/")} class:list={["nav-link", { active: isActive("/") }]}>
            {t.nav.links.home}
          </a>
        </li>
        <li>
          <a href={buildPath("/vjencanja")} class:list={["nav-link", { active: isActive("/vjencanja") }]}>
            {t.nav.links.weddings}
          </a>
        </li>
        <li>
          <a href={buildPath("/proslave-i-eventi")} class:list={["nav-link", { active: isActive("/proslave-i-eventi") }]}>
            {t.nav.links.events}
          </a>
        </li>
        <li>
          <a href={buildPath("/najam-opreme")} class:list={["nav-link", { active: isActive("/najam-opreme") }]}>
            {t.nav.links.rental}
          </a>
        </li>
        <li>
          <div class="nav-lang nav-lang--mobile" aria-label={t.nav.languageLabel}>
            <a href={hrPath} class:list={["lang-link", { active: !isEnglish }]} aria-current={!isEnglish ? "page" : undefined}>
              {t.nav.languageHr}
            </a>
            <span class="lang-divider" aria-hidden="true">/</span>
            <a href={enPath} class:list={["lang-link", { active: isEnglish }]} aria-current={isEnglish ? "page" : undefined}>
              {t.nav.languageEn}
            </a>
          </div>
        </li>
        <li>
          <button type="button" class="btn-primary" data-contact-open>
            {t.nav.contact}
          </button>
        </li>
      </ul>
    </div>
  </nav>
</header>

<script>
  const mobileToggle = document.getElementById('mobile-menu-toggle') as HTMLInputElement | null;
  const mobileButton = document.querySelector('.mobile-menu-btn') as HTMLButtonElement | null;
  mobileButton?.addEventListener('click', () => {
    if (mobileToggle) mobileToggle.checked = !mobileToggle.checked;
  });
</script>

<style>
  .nav-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 140;
    background: var(--surface);
    border-bottom: 1px solid rgba(44, 44, 44, 0.08);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 24px;
    min-height: var(--nav-height-desktop);
  }

  .nav-logo {
    display: inline-flex;
    align-items: center;
    width: clamp(108px, 9vw, 138px);
    aspect-ratio: 2.55 / 1;
    overflow: hidden;
  }

  .nav-logo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: left center;
    background-color: transparent;
  }

  .nav-logo :global(picture) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: clamp(14px, 2vw, 30px);
    list-style: none;
    margin-left: 4px;
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    font-size: 0.94rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    color: var(--charcoal-gray);
    position: relative;
    transition: color 0.2s ease, opacity 0.2s ease;
    white-space: nowrap;
  }

  .nav-link::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -9px;
    width: 100%;
    height: 1px;
    background: var(--dark);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.25s ease;
  }

  .nav-link:hover,
  .nav-link:focus-visible {
    color: var(--dark);
    opacity: 1;
  }

  .nav-link:hover::after,
  .nav-link:focus-visible::after,
  .nav-link.active::after {
    transform: scaleX(1);
  }

  .nav-link.active {
    color: var(--dark);
  }

  .nav-cta {
    margin-left: auto;
    min-width: 118px;
    padding: 12px 18px;
    font-size: 0.94rem;
    line-height: 1.25;
    letter-spacing: 0.06em;
  }

  .nav-lang {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 10px;
    border-radius: 999px;
    border: 1px solid rgba(44, 44, 44, 0.18);
    font-size: 0.90rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--charcoal-gray);
  }

  .lang-link {
    color: inherit;
    font-weight: 600;
    transition: color 0.2s ease, opacity 0.2s ease;
  }

  .lang-link.active {
    color: var(--dark);
  }

  .lang-divider {
    opacity: 0.5;
  }

  .mobile-toggle-input {
    display: none;
  }

  .mobile-menu-btn {
    display: none;
    flex-direction: column;
    gap: 4px;
    cursor: pointer;
    padding: 7px 0 7px 10px;
    border: none;
    background: transparent;
  }

  .hamburger-line {
    width: 20px;
    height: 1px;
    background: var(--dark);
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  .mobile-nav {
    display: none;
  }

  @media (max-width: 1100px) {
    .nav-links {
      gap: 16px;
    }

    .nav-link {
      font-size: 0.79rem;
    }
  }

  @media (max-width: 900px) {
    .nav-links,
    .nav-cta,
    .nav-lang {
      display: none;
    }

    .mobile-menu-btn {
      display: flex;
      margin-left: auto;
    }

    .mobile-nav {
      display: block;
      position: fixed;
      inset: var(--nav-height-desktop) 0 auto;
      padding: 20px;
      background: var(--surface);
      border-bottom: 1px solid rgba(44, 44, 44, 0.08);
      opacity: 0;
      visibility: hidden;
      transition: opacity 0.2s ease, visibility 0.2s ease;
    }

    .mobile-nav ul {
      list-style: none;
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 14px;
    }

    .mobile-nav .nav-link {
      font-size: 0.9rem;
      letter-spacing: 0.06em;
    }

    .mobile-nav .btn-primary {
      margin-top: 8px;
    }

    .mobile-nav .nav-lang {
      display: inline-flex;
      padding: 6px 12px;
    }

    .mobile-toggle-input:checked ~ .mobile-menu-btn .hamburger-line:nth-child(1) {
      transform: translateY(5px) rotate(45deg);
    }

    .mobile-toggle-input:checked ~ .mobile-menu-btn .hamburger-line:nth-child(2) {
      opacity: 0;
    }

    .mobile-toggle-input:checked ~ .mobile-menu-btn .hamburger-line:nth-child(3) {
      transform: translateY(-5px) rotate(-45deg);
    }

    .mobile-toggle-input:checked ~ .mobile-nav {
      opacity: 1;
      visibility: visible;
    }
  }

  @media (max-width: 768px) {
    .nav-inner {
      min-height: var(--nav-height-mobile);
    }

    .mobile-nav {
      inset: var(--nav-height-mobile) 0 auto;
    }

    .nav-logo {
      width: 120px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-link,
    .nav-link::after,
    .hamburger-line,
    .mobile-nav {
      transition: none;
    }
  }
</style>
