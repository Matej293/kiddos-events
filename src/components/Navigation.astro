---
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header class="nav-header">
  <nav class="container nav-inner" aria-label="Glavna navigacija">
    <a href="/" class="nav-logo" aria-label="Kiddos Events - Početna">
      <Image src={logo} alt="Kiddos Events logo" width={140} height={60} loading="eager" />
    </a>

    <ul class="nav-links" role="list">
      <li><a href="/o-nama" class:list={['nav-link', { active: currentPath === '/o-nama' }]}>O nama</a></li>
      <li><a href="/galerija" class:list={['nav-link', { active: currentPath === '/galerija' }]}>Galerija</a></li>
      <li><a href="/usluge" class:list={['nav-link', { active: currentPath === '/usluge' }]}>Usluge</a></li>
    </ul>

    <label for="contact-toggle" class="btn-primary nav-cta" role="button" tabindex="0">
      Kontakt
    </label>

    <input type="checkbox" id="mobile-menu-toggle" class="mobile-toggle-input" aria-hidden="true" />
    <label for="mobile-menu-toggle" class="mobile-menu-btn" aria-label="Otvori izbornik">
      <span class="hamburger-line"></span>
      <span class="hamburger-line"></span>
      <span class="hamburger-line"></span>
    </label>

    <div class="mobile-nav">
      <ul role="list">
        <li><a href="/o-nama" class:list={['nav-link', { active: currentPath === '/o-nama' }]}>O nama</a></li>
        <li><a href="/galerija" class:list={['nav-link', { active: currentPath === '/galerija' }]}>Galerija</a></li>
        <li><a href="/usluge" class:list={['nav-link', { active: currentPath === '/usluge' }]}>Usluge</a></li>
        <li>
          <label for="contact-toggle" class="btn-primary" role="button" tabindex="0" style="margin-top: 8px;">
            Kontakt
          </label>
        </li>
      </ul>
    </div>
  </nav>
</header>

<style>
  .nav-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    background-color: rgba(253, 251, 247, 0.9);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid rgba(186, 168, 152, 0.15);
    transition: background-color 0.3s ease;
  }

  .nav-header.menu-open {
    background-color: var(--cream);
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 72px;
  }

  .nav-logo {
    flex-shrink: 0;
    transition: opacity 0.2s ease;
  }

  .nav-logo:hover {
    opacity: 0.85;
  }

  .nav-logo :global(img) {
    height: 44px;
    width: auto;
  }

  .nav-links {
    display: flex;
    gap: 40px;
    list-style: none;
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
  }

  .nav-link {
    font-family: var(--font-body);
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--charcoal-gray);
    position: relative;
    transition: color 0.2s ease;
  }

  .nav-link::after {
    content: '';
    position: absolute;
    bottom: -4px;
    left: 0;
    width: 0;
    height: 2px;
    background-color: var(--sky-blue);
    border-radius: 1px;
    transition: width 0.25s ease;
  }

  .nav-link:hover {
    color: var(--dark);
  }

  .nav-link:hover::after,
  .nav-link.active::after {
    width: 100%;
  }

  .nav-link.active {
    color: var(--dark);
    font-weight: 600;
  }

  .nav-cta {
    padding: 10px 24px;
    font-size: 0.875rem;
    cursor: pointer;
  }

  .mobile-toggle-input {
    display: none;
  }

  .mobile-menu-btn {
    display: none;
    flex-direction: column;
    gap: 5px;
    cursor: pointer;
    padding: 8px;
    z-index: 110;
  }

  .hamburger-line {
    display: block;
    width: 22px;
    height: 2px;
    background-color: var(--dark);
    border-radius: 1px;
    transition: transform 0.3s ease, opacity 0.3s ease;
  }

  .mobile-nav {
    display: none;
  }

  @media (max-width: 768px) {
    .nav-links {
      display: none;
    }

    .nav-cta {
      display: none;
    }

    .mobile-menu-btn {
      display: flex;
    }

    .mobile-nav {
      display: block;
      position: fixed;
      inset: 0;
      background-color: var(--cream);
      z-index: 105;
      padding: 100px 32px 32px;
      opacity: 0;
      visibility: hidden;
      transition: opacity 0.3s ease, visibility 0.3s ease;
    }

    .mobile-nav ul {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 24px;
    }

    .mobile-nav .nav-link {
      font-size: 1.5rem;
      font-family: var(--font-display);
      font-weight: 500;
    }

    .mobile-nav .nav-link.active {
      color: var(--sky-blue);
    }

    .mobile-toggle-input:checked ~ .mobile-nav {
      opacity: 1;
      visibility: visible;
    }

    .mobile-toggle-input:checked ~ .mobile-menu-btn .hamburger-line:nth-child(1) {
      transform: translateY(7px) rotate(45deg);
    }

    .mobile-toggle-input:checked ~ .mobile-menu-btn .hamburger-line:nth-child(2) {
      opacity: 0;
    }

    .mobile-toggle-input:checked ~ .mobile-menu-btn .hamburger-line:nth-child(3) {
      transform: translateY(-7px) rotate(-45deg);
    }
  }
</style>

<script>
  const toggle = document.getElementById("mobile-menu-toggle") as HTMLInputElement;
  const header = document.querySelector(".nav-header") as HTMLElement;
  if (toggle && header) {
    toggle.addEventListener("change", () => {
      header.classList.toggle("menu-open", toggle.checked);
    });
  }
</script>
