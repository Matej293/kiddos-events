---
import Layout from "../layouts/Layout.astro";
import Navigation from "../components/Navigation.astro";
import PageHero from "../components/PageHero.astro";
import Footer from "../components/Footer.astro";
import { Image } from "astro:assets";

// Soft play images
import igraonica001 from "../assets/gallery/igraonica-001.jpg";
import igraonica02 from "../assets/gallery/igraonica-02.jpeg";
import igraonica17 from "../assets/gallery/igraonica-17.jpg";
import igraonica05 from "../assets/gallery/igraonica-05.jpeg";
import igraonica23 from "../assets/gallery/igraonica-23.jpg";

// Birthday images
import rodendan01 from "../assets/gallery/rodendan-01.jpg";
import rodendan02 from "../assets/gallery/rodendan-02.jpg";
import rodendan03 from "../assets/gallery/rodendan-03.jpg";
import rodendan05 from "../assets/gallery/rodendan-05.jpg";

// Wedding images
import vjencanje01 from "../assets/gallery/vjencanje-01.jpg";
import vjencanje03 from "../assets/gallery/vjencanje-03.jpg";
import vjencanje05 from "../assets/gallery/vjencanje-05.jpg";
import vjencanje06 from "../assets/gallery/vjencanje-06.jpg";

const softPlayImages = [
  { img: igraonica001, alt: "Soft play igraonica - prvi pogled" },
  { img: igraonica02, alt: "Dijete u bazenu s lopticama" },
  { img: igraonica17, alt: "Igračke - tobogan" },
  { img: igraonica05, alt: "Druženje kod tobogana u igraonici" },
  { img: igraonica23, alt: "Crtanje s djecom u igraonici" },
];

const birthdayImages = [
  { img: rodendan01, alt: "Face painting - dječji rođendan" },
  { img: rodendan02, alt: "Djeca s oslikanim licima" },
  { img: rodendan03, alt: "Kreativna radionica na rođendanu" },
  { img: rodendan05, alt: "Dječji rođendan" },
];

const weddingImages = [
  { img: vjencanje01, alt: "Kiddos Events na vjenčanju - fun corner" },
  { img: vjencanje03, alt: "Igranje s djetetom na vjenčanju" },
  { img: vjencanje05, alt: "Igranje s djetetom na vjenčanju" },
  { img: vjencanje06, alt: "Slaganje igračaka na vjenčanju" },
];
---

<Layout
  title="Usluge | Kiddos Events"
  description="Pogledajte naše usluge: soft play igraonice, organizacija dječjih rođendana i profesionalna zabava za djecu na vjenčanjima. Cijene i paketi."
>
  <Navigation />
  <main>
    <PageHero
      title="Naše usluge"
      subtitle="Tri načina na koja Kiddos Events unosi radost u vaše posebne trenutke."
      accentColor="var(--peach)"
      bgTint="var(--cream-peach)"
    />

    <section class="section service-section" id="soft-play">
      <div class="container">
        <div class="service-header">
          <span
            class="section-tag"
            style="color: var(--soft-pink); border-color: var(--soft-pink);"
            >Igraonica</span
          >
          <h2>Soft play igraonica</h2>
          <p class="service-lead">
            Mekana, sigurna i šarena oprema za igru prilagođena najmlađima.
            Donosimo igraonicu k vama, na vaš event, u vaš prostor.
          </p>
          <div
            class="service-age-badge"
            style="background-color: rgba(242, 190, 206, 0.15); color: var(--soft-pink);"
          >
            Dob: 1 – 5 godina
          </div>
        </div>

        <div class="service-carousel">
          {
            softPlayImages.map((item) => (
              <button
                class="carousel-item lightbox-trigger img-wrap"
                type="button"
                aria-label="Povećaj sliku"
              >
                <Image
                  src={item.img}
                  alt={item.alt}
                  width={400}
                  height={300}
                  loading="eager"
                  class="carousel-img"
                />
              </button>
            ))
          }
        </div>

        <div class="pricing-grid pricing-grid--4">
          <div class="price-card">
            <div
              class="price-card-badge"
              style="background-color: var(--soft-pink);"
            >
              Najpopularniji
            </div>
            <h3>Mini set</h3>
            <div class="price-amount">100 <span>€</span></div>
            <ul class="price-features">
              <li>Tunel sa stepenicama i toboganom</li>
              <li>Bazen s lopticama i stepenicama (130×130 cm, 500 loptica)</li>
              <li>Valoviti i polukružni blok</li>
              <li>Podloga za igru</li>
            </ul>
            <div class="price-bonus">
              <span>Gratis:</span> 2 gumene igračke za skakanje
            </div>
          </div>

          <div class="price-card price-card--highlight">
            <div
              class="price-card-badge"
              style="background-color: var(--butter-yellow);"
            >
              Najbolja vrijednost
            </div>
            <h3>Maxi set</h3>
            <div class="price-amount">150 <span>€</span></div>
            <ul class="price-features">
              <li>Sve iz Mini seta</li>
              <li>Velike stepenice s toboganom</li>
              <li>Ljuljačka u obliku polumjeseca</li>
            </ul>
            <div class="price-bonus">
              <span>Gratis:</span> 4 gumene igračke za skakanje
            </div>
          </div>

          <div class="price-card">
            <h3>Bijeli mini dvorac</h3>
            <div class="price-amount">80 <span>€</span></div>
            <ul class="price-features">
              <li>Dimenzije: 1,8 m × 1,8 m × 2,4 m</li>
              <li>Tobogan</li>
              <li>Sigurnosna mreža</li>
            </ul>
          </div>

          <div class="price-card">
            <h3>Beige set</h3>
            <div class="price-amount">120 <span>€</span></div>
            <ul class="price-features">
              <li>Set u neutralnim tonovima</li>
              <li>Elegantan dizajn za svaki prostor</li>
              <li>Idealan za outdoor evente</li>
            </ul>
          </div>
        </div>

        <div class="combo-banner">
          <h3>Kombinacije</h3>
          <div class="combo-grid">
            <div class="combo-item">
              <span class="combo-name">Mini set + Dvorac</span>
              <span class="combo-price">150 €</span>
            </div>
            <div class="combo-item">
              <span class="combo-name">Maxi set + Dvorac</span>
              <span class="combo-price">200 €</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section
      class="section service-section service-section--alt"
      id="rodendani"
    >
      <div class="container">
        <div class="service-header">
          <span
            class="section-tag"
            style="color: var(--butter-yellow); border-color: var(--butter-yellow);"
            >Rođendani</span
          >
          <h2>Dječji rođendani</h2>
          <p class="service-lead">
            Kompletna animacija za dječje rođendane u trajanju od 2 sata.
            Profesionalne animatorice, kreativne radionice i sportske igre, sve
            prilagođeno dobi djece.
          </p>
          <div
            class="service-age-badge"
            style="background-color: rgba(247, 217, 106, 0.15); color: #C4A830;"
          >
            Dob: 4 – 12 godina
          </div>
        </div>

        <div class="service-carousel">
          {
            birthdayImages.map((item) => (
              <button
                class="carousel-item lightbox-trigger img-wrap"
                type="button"
                aria-label="Povećaj sliku"
              >
                <Image
                  src={item.img}
                  alt={item.alt}
                  width={400}
                  height={300}
                  loading="eager"
                  class="carousel-img"
                />
              </button>
            ))
          }
        </div>

        <div class="features-row">
          <div class="feature-card">
            <svg
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="var(--butter-yellow)"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              ><path
                d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2z"
              ></path><path d="M8 14s1.5 2 4 2 4-2 4-2"></path><line
                x1="9"
                y1="9"
                x2="9.01"
                y2="9"></line><line x1="15" y1="9" x2="15.01" y2="9"
              ></line></svg
            >
            <span>Face painting</span>
          </div>
          <div class="feature-card">
            <svg
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="var(--butter-yellow)"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              ><path d="M12 2L2 7l10 5 10-5-10-5z"></path><path
                d="M2 17l10 5 10-5"></path><path d="M2 12l10 5 10-5"
              ></path></svg
            >
            <span>Kreativne radionice</span>
          </div>
          <div class="feature-card">
            <svg
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="var(--butter-yellow)"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              ><circle cx="12" cy="12" r="10"></circle><polygon
                points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"
              ></polygon></svg
            >
            <span>Sportske igre</span>
          </div>
          <div class="feature-card">
            <svg
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="var(--butter-yellow)"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              ><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"
              ></path><circle cx="9" cy="7" r="4"></circle><path
                d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path
                d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg
            >
            <span>Min. 2 animatorice</span>
          </div>
        </div>

        <div class="pricing-grid pricing-grid--3">
          <div class="price-card">
            <h3>Do 15 djece</h3>
            <div class="price-amount">160 <span>€</span></div>
            <ul class="price-features">
              <li>2 sata animacije</li>
              <li>Face painting</li>
              <li>Kreativne radionice</li>
              <li>Sportske igre</li>
              <li>2 animatorice</li>
            </ul>
          </div>

          <div class="price-card price-card--highlight">
            <div
              class="price-card-badge"
              style="background-color: var(--butter-yellow);"
            >
              Najpopularniji
            </div>
            <h3>Do 20 djece</h3>
            <div class="price-amount">190 <span>€</span></div>
            <ul class="price-features">
              <li>2 sata animacije</li>
              <li>Face painting</li>
              <li>Kreativne radionice</li>
              <li>Sportske igre</li>
              <li>Prilagođen broj animatorica</li>
            </ul>
          </div>

          <div class="price-card">
            <h3>Do 30 djece</h3>
            <div class="price-amount">220 <span>€</span></div>
            <ul class="price-features">
              <li>2 sata animacije</li>
              <li>Face painting</li>
              <li>Kreativne radionice</li>
              <li>Sportske igre</li>
              <li>Prilagođen broj animatorica</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <section class="section service-section" id="vjencanja">
      <div class="container">
        <div class="service-header">
          <span
            class="section-tag"
            style="color: var(--peach); border-color: var(--peach);"
            >Vjenčanja</span
          >
          <h2>Zabava na vjenčanjima</h2>
          <p class="service-lead">
            Profesionalna zabava i briga za djecu na vjenčanjima. Kreativne
            radionice, igre i animacija prilagođena temi vašeg vjenčanja, dok vi
            uživate u svom posebnom danu.
          </p>
          <div
            class="service-age-badge"
            style="background-color: rgba(242, 196, 162, 0.15); color: #C49060;"
          >
            Svi uzrasti, prilagođavamo se
          </div>
        </div>

        <div class="service-carousel">
          {
            weddingImages.map((item) => (
              <button
                class="carousel-item lightbox-trigger img-wrap"
                type="button"
                aria-label="Povećaj sliku"
              >
                <Image
                  src={item.img}
                  alt={item.alt}
                  width={400}
                  height={300}
                  loading="eager"
                  class="carousel-img"
                />
              </button>
            ))
          }
        </div>

        <div class="features-row">
          <div class="feature-card">
            <svg
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="var(--peach)"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              ><path d="M12 2L2 7l10 5 10-5-10-5z"></path><path
                d="M2 17l10 5 10-5"></path><path d="M2 12l10 5 10-5"
              ></path></svg
            >
            <span>Kreativne radionice</span>
          </div>
          <div class="feature-card">
            <svg
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="var(--peach)"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              ><circle cx="12" cy="12" r="10"></circle><path
                d="M8 14s1.5 2 4 2 4-2 4-2"></path><line
                x1="9"
                y1="9"
                x2="9.01"
                y2="9"></line><line x1="15" y1="9" x2="15.01" y2="9"
              ></line></svg
            >
            <span>Igre za sve uzraste</span>
          </div>
          <div class="feature-card">
            <svg
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="var(--peach)"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              ><path
                d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"
              ></path></svg
            >
            <span>Prilagođeno temi vjenčanja</span>
          </div>
          <div class="feature-card">
            <svg
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="var(--peach)"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              ><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"
              ></path></svg
            >
            <span>Potpuna briga za djecu</span>
          </div>
        </div>

        <div class="price-inquiry">
          <div class="price-inquiry-inner">
            <div class="price-inquiry-text">
              <h3>Cijena na upit</h3>
              <p>
                Svako vjenčanje je jedinstveno. Prilagođavamo program, broj
                animatora i aktivnosti vašim potrebama i broju djece. Javite nam
                se za personaliziranu ponudu.
              </p>
            </div>
            <label
              for="contact-toggle"
              class="btn-primary"
              role="button"
              tabindex="0"
            >
              Zatražite ponudu
            </label>
          </div>
        </div>
      </div>
    </section>

    <section class="pricing-hint">
      <div class="container pricing-content">
        <span class="section-tag">Kontakt</span>
        <h2>Imate pitanja?</h2>
        <p>
          Javite nam se za dodatne informacije, prilagođene ponude ili bilo
          kakva pitanja. Rado ćemo vam pomoći!
        </p>
        <label
          for="contact-toggle"
          class="btn-secondary"
          role="button"
          tabindex="0"
        >
          Kontaktirajte nas
        </label>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<!-- Lightbox -->
<div class="lightbox" id="usluge-lightbox" aria-hidden="true">
  <button class="lightbox-close" type="button" aria-label="Zatvori">
    <svg
      width="24"
      height="24"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"><path d="M18 6L6 18M6 6l12 12"></path></svg
    >
  </button>
  <img class="lightbox-img" src="" alt="" />
</div>

<style>
  .service-section {
    position: relative;
    background:
      radial-gradient(
        ellipse at 10% 20%,
        rgba(242, 190, 206, 0.05) 0%,
        transparent 50%
      ),
      radial-gradient(
        ellipse at 90% 80%,
        rgba(141, 216, 236, 0.04) 0%,
        transparent 50%
      ),
      var(--cream);
  }

  .service-section--alt {
    background:
      radial-gradient(
        ellipse at 90% 20%,
        rgba(247, 217, 106, 0.06) 0%,
        transparent 50%
      ),
      radial-gradient(
        ellipse at 10% 80%,
        rgba(242, 196, 162, 0.04) 0%,
        transparent 50%
      ),
      var(--cream-yellow);
  }

  .service-header {
    text-align: center;
    margin-bottom: 40px;
  }

  .service-lead {
    font-size: 1.05rem;
    color: var(--charcoal-gray);
    max-width: 600px;
    margin-inline: auto;
    margin-bottom: 16px;
  }

  .service-age-badge {
    display: inline-block;
    padding: 8px 18px;
    font-family: var(--font-body);
    font-size: 0.8rem;
    font-weight: 600;
    border-radius: var(--radius-pill);
  }

  .service-carousel {
    cursor: grab;
    display: flex;
    gap: 16px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    padding-bottom: 8px;
    margin-bottom: 48px;
    scrollbar-width: thin;
    scrollbar-color: var(--taupe) transparent;
  }

  .service-carousel.is-dragging {
    cursor: grabbing;
    scroll-snap-type: none;
    user-select: none;
  }

  .service-carousel::-webkit-scrollbar {
    height: 6px;
  }

  .service-carousel::-webkit-scrollbar-track {
    background: transparent;
  }

  .service-carousel::-webkit-scrollbar-thumb {
    background-color: rgba(186, 168, 152, 0.4);
    border-radius: 3px;
  }

  .carousel-item {
    flex: 0 0 auto;
    width: 320px;
    border-radius: var(--radius-brand);
    overflow: hidden;
    scroll-snap-align: start;
    box-shadow: var(--shadow-card);
    cursor: pointer;
    border: none;
    padding: 0;
    background: none;
    transition:
      transform 0.3s ease,
      box-shadow 0.3s ease;
  }

  .carousel-item:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-card-hover);
  }

  .carousel-img {
    width: 100%;
    height: 240px;
    object-fit: cover;
    display: block;
    -webkit-user-drag: none;
    user-select: none;
    pointer-events: none;
  }

  .pricing-grid {
    display: grid;
    gap: 20px;
    margin-bottom: 32px;
  }

  .pricing-grid--4 {
    grid-template-columns: repeat(4, 1fr);
  }

  .pricing-grid--3 {
    grid-template-columns: repeat(3, 1fr);
  }

  .price-card {
    position: relative;
    background-color: var(--cream);
    border: 1px solid rgba(186, 168, 152, 0.3);
    border-radius: var(--radius-brand);
    padding: 32px 24px 28px;
    box-shadow: var(--shadow-card);
    transition:
      transform 0.3s ease,
      box-shadow 0.3s ease;
    display: flex;
    flex-direction: column;
  }

  .price-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-card-hover);
  }

  .price-card--highlight {
    border-color: var(--sky-blue);
    border-width: 2px;
    box-shadow:
      var(--shadow-card),
      0 0 0 1px rgba(141, 216, 236, 0.2);
  }

  .price-card-badge {
    position: absolute;
    top: -12px;
    left: 50%;
    transform: translateX(-50%);
    padding: 4px 16px;
    font-family: var(--font-body);
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--dark);
    border-radius: var(--radius-pill);
    white-space: nowrap;
  }

  .price-card h3 {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--dark);
    margin-bottom: 8px;
    text-align: center;
  }

  .price-amount {
    font-family: var(--font-display);
    font-size: 2.5rem;
    font-weight: 700;
    color: var(--dark);
    text-align: center;
    line-height: 1.1;
    margin-bottom: 20px;
  }

  .price-amount span {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--charcoal-gray);
  }

  .price-features {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-bottom: 16px;
    flex-grow: 1;
  }

  .price-features li {
    font-size: 0.85rem;
    color: var(--charcoal-gray);
    padding-left: 20px;
    position: relative;
    line-height: 1.5;
  }

  .price-features li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 7px;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: var(--sky-blue);
    opacity: 0.6;
  }

  .price-bonus {
    padding: 10px 14px;
    background-color: rgba(186, 218, 144, 0.12);
    border-radius: 12px;
    font-size: 0.8rem;
    color: var(--charcoal-gray);
    margin-top: auto;
  }

  .price-bonus span {
    font-weight: 700;
    color: var(--sage-green);
  }

  .combo-banner {
    background-color: var(--cream-blue);
    border-radius: var(--radius-brand);
    padding: 32px;
    text-align: center;
  }

  .combo-banner h3 {
    font-family: var(--font-display);
    font-size: 1.25rem;
    margin-bottom: 20px;
    color: var(--dark);
  }

  .combo-grid {
    display: flex;
    gap: 24px;
    justify-content: center;
    flex-wrap: wrap;
  }

  .combo-item {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 16px 28px;
    background-color: var(--cream);
    border: 1px solid rgba(186, 168, 152, 0.3);
    border-radius: var(--radius-brand);
    box-shadow: var(--shadow-card);
  }

  .combo-name {
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--charcoal-gray);
  }

  .combo-price {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--dark);
  }

  .features-row {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
    margin-bottom: 40px;
  }

  .feature-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    padding: 20px 12px;
    background-color: var(--cream);
    border: 1px solid rgba(186, 168, 152, 0.2);
    border-radius: var(--radius-brand);
    text-align: center;
  }

  .feature-card span {
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--charcoal-gray);
  }

  .price-inquiry {
    margin-top: 8px;
  }

  .price-inquiry-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
    padding: 40px;
    background: linear-gradient(135deg, var(--cream-peach), var(--cream));
    border: 1px solid rgba(242, 196, 162, 0.3);
    border-radius: var(--radius-brand);
    box-shadow: var(--shadow-card);
    transition:
      transform 0.3s ease,
      box-shadow 0.3s ease;
  }

  .price-inquiry-inner:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-card-hover);
  }

  .price-inquiry-text h3 {
    font-family: var(--font-display);
    font-size: 1.5rem;
    margin-bottom: 8px;
  }

  .price-inquiry-text p {
    font-size: 0.9rem;
    color: var(--charcoal-gray);
    max-width: 500px;
  }

  .pricing-hint {
    background:
      radial-gradient(
        ellipse at 50% 50%,
        rgba(186, 218, 144, 0.08) 0%,
        transparent 60%
      ),
      var(--cream-sage);
    padding: 64px 0;
  }

  .pricing-content {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
  }

  .pricing-content p {
    color: var(--charcoal-gray);
    margin-bottom: 8px;
    max-width: 540px;
  }

  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 300;
    background-color: rgba(44, 44, 44, 0.85);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.3s ease,
      visibility 0.3s ease;
  }

  .lightbox[aria-hidden="false"] {
    opacity: 1;
    visibility: visible;
  }

  .lightbox-close {
    position: absolute;
    top: 20px;
    right: 20px;
    background: rgba(253, 251, 247, 0.15);
    border: none;
    color: var(--cream);
    width: 44px;
    height: 44px;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background-color 0.2s ease;
    z-index: 2;
  }

  .lightbox-close:hover {
    background: rgba(253, 251, 247, 0.3);
  }

  .lightbox-img {
    max-width: 90vw;
    max-height: 85vh;
    object-fit: contain;
    border-radius: 12px;
  }

  @media (max-width: 1024px) {
    .pricing-grid--4 {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .pricing-grid--4,
    .pricing-grid--3 {
      grid-template-columns: 1fr;
    }

    .features-row {
      grid-template-columns: repeat(2, 1fr);
    }

    .price-inquiry-inner {
      flex-direction: column;
      text-align: center;
      padding: 28px;
    }

    .carousel-item {
      width: 260px;
    }

    .carousel-img {
      height: 200px;
    }
  }

  @media (max-width: 480px) {
    .features-row {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .price-card,
    .carousel-item,
    .price-inquiry-inner,
    .lightbox {
      transition: none;
    }
    .price-card:hover,
    .carousel-item:hover,
    .price-inquiry-inner:hover {
      transform: none;
    }
  }
</style>

<script>
  const lightbox = document.getElementById("usluge-lightbox") as HTMLDivElement;
  const lightboxImg = lightbox?.querySelector(
    ".lightbox-img",
  ) as HTMLImageElement;
  const lightboxClose = lightbox?.querySelector(
    ".lightbox-close",
  ) as HTMLButtonElement;
  const triggers = document.querySelectorAll(".lightbox-trigger");

  triggers.forEach((trigger) => {
    trigger.addEventListener("click", () => {
      const img = trigger.querySelector("img");
      if (img && lightbox && lightboxImg) {
        lightboxImg.src = img.src;
        lightboxImg.alt = img.alt;
        lightbox.setAttribute("aria-hidden", "false");
      }
    });
  });

  function closeLightbox() {
    lightbox?.setAttribute("aria-hidden", "true");
  }

  lightboxClose?.addEventListener("click", closeLightbox);
  lightbox?.addEventListener("click", (e) => {
    if (e.target === lightbox) closeLightbox();
  });
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") closeLightbox();
  });

  document
    .querySelectorAll<HTMLElement>(".service-carousel")
    .forEach((carousel) => {
      let isDown = false;
      let startX: number;
      let scrollLeft: number;

      carousel.addEventListener("mousedown", (e) => {
        isDown = true;
        carousel.classList.add("is-dragging");
        startX = e.pageX - carousel.offsetLeft;
        scrollLeft = carousel.scrollLeft;
      });

      carousel.addEventListener("mouseleave", () => {
        isDown = false;
        carousel.classList.remove("is-dragging");
      });

      carousel.addEventListener("mouseup", () => {
        isDown = false;
        carousel.classList.remove("is-dragging");
      });

      carousel.addEventListener("mousemove", (e) => {
        if (!isDown) return;
        e.preventDefault();
        const x = e.pageX - carousel.offsetLeft;
        const walk = (x - startX) * 1.5;
        carousel.scrollLeft = scrollLeft - walk;
      });
    });
</script>
