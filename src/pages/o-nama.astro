---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import PageHero from '../components/PageHero.astro';
import Footer from '../components/Footer.astro';
import { Image } from 'astro:assets';

import onama01 from '../assets/gallery/o-nama-01.jpg';
import onama02 from '../assets/gallery/o-nama-02.jpg';
import onama03 from '../assets/gallery/o-nama-03.jpg';
---

<Layout
  title="O nama | Kiddos Events"
  description="Upoznajte Kiddos Events tim. Organiziramo dječje rođendane, igraonice i zabavu na vjenčanjima s ljubavlju i pažnjom prema detaljima."
>
  <Navigation />
  <main>
    <PageHero
      title="O nama"
      subtitle="Mali tim, velika strast. Upoznajte ljude iza Kiddos Events."
      accentColor="var(--soft-pink)"
      bgTint="var(--cream-pink)"
    />

    <!-- Our Story -->
    <section class="section story-section">
      <div class="container story-grid">
        <div class="story-image">
          <Image
            src={onama01}
            alt="Kiddos Events tim s djecom"
            width={560}
            height={420}
            loading="lazy"
            class="story-img"
          />
          <div class="story-image-accent" aria-hidden="true"></div>
        </div>
        <div class="story-content">
          <span class="section-tag">Naša priča</span>
          <h2>Radost je naša misija</h2>
          <p>
            Kiddos Events nastao je iz jednostavne ideje: svako dijete zaslužuje savršen
            event. Počeli smo kao mala ekipa entuzijasta, a danas smo tim profesionalaca
            koji s jednako velikom strašću pristupa svakom rođendanu, igraonici i vjenčanju.
          </p>
          <p>
            Vjerujemo da su dječji osmijesi najbolji pokazatelj dobro obavljenog posla.
            Svaki detalj osmislimo s pažnjom, od izbora igara i aktivnosti do sigurnosti
            prostora i kvalitete opreme.
          </p>
        </div>
      </div>
    </section>

    <!-- Team gallery -->
    <section class="team-gallery">
      <div class="container team-gallery-grid">
        <div class="team-gallery-item img-wrap">
          <Image
            src={onama02}
            alt="Kiddos Events tim na vjenčanju"
            width={580}
            height={380}
            loading="lazy"
            class="team-gallery-img"
          />
        </div>
        <div class="team-gallery-item img-wrap">
          <Image
            src={onama03}
            alt="Kiddos Events tim, zajednička fotografija"
            width={580}
            height={380}
            loading="lazy"
            class="team-gallery-img"
          />
        </div>
      </div>
    </section>

    <!-- Values -->
    <section class="section values-section">
      <div class="container">
        <div class="values-header">
          <span class="section-tag">Naše vrijednosti</span>
          <h2>Što nas pokreće</h2>
        </div>
        <div class="values-grid">
          <div class="value-card">
            <div class="value-icon" style="background-color: rgba(141, 216, 236, 0.15);">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="var(--sky-blue)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            </div>
            <h3>Sigurnost</h3>
            <p>Sva oprema je certificirana i redovito pregledana. Sigurnost djece nam je uvijek na prvom mjestu.</p>
          </div>
          <div class="value-card">
            <div class="value-icon" style="background-color: rgba(242, 190, 206, 0.15);">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="var(--soft-pink)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>
            </div>
            <h3>Kreativnost</h3>
            <p>Svaki event je jedinstven. Osmišljavamo tematske aktivnosti i igre prilagođene dobi i interesima djece.</p>
          </div>
          <div class="value-card">
            <div class="value-icon" style="background-color: rgba(247, 217, 106, 0.15);">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="var(--butter-yellow)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M8 14s1.5 2 4 2 4-2 4-2"/><line x1="9" y1="9" x2="9.01" y2="9"/><line x1="15" y1="9" x2="15.01" y2="9"/></svg>
            </div>
            <h3>Radost</h3>
            <p>Živimo za trenutke kad dijete zaboravi na sve i jednostavno uživa. To je ono što nas pokreće svaki dan.</p>
          </div>
          <div class="value-card">
            <div class="value-icon" style="background-color: rgba(186, 218, 144, 0.15);">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="var(--sage-green)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
            </div>
            <h3>Pažnja</h3>
            <p>Slušamo vaše želje i prilagođavamo svaki detalj. Vaše zadovoljstvo je naš cilj, od prvog poziva do zadnjeg plesa.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA Banner -->
    <section class="cta-banner">
      <div class="container cta-content">
        <h2>Želite organizirati event?</h2>
        <p>Javite nam se i zajedno ćemo osmisliti savršenu zabavu za vaše mališane.</p>
        <label for="contact-toggle" class="btn-primary" role="button" tabindex="0">
          Kontaktirajte nas
        </label>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  /* Story Section */
  .story-section {
    background:
      radial-gradient(ellipse at 80% 20%, rgba(242, 190, 206, 0.06) 0%, transparent 50%),
      radial-gradient(ellipse at 20% 70%, rgba(247, 217, 106, 0.04) 0%, transparent 50%),
      var(--cream);
  }

  .story-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 64px;
    align-items: center;
  }

  .story-image {
    position: relative;
  }

  .story-img {
    border-radius: var(--radius-brand);
    box-shadow: var(--shadow-card);
    width: 100%;
    height: auto;
  }

  .story-image-accent {
    position: absolute;
    width: 140px;
    height: 140px;
    border-radius: 50%;
    background-color: var(--butter-yellow);
    opacity: 0.2;
    bottom: -30px;
    right: -30px;
    z-index: -1;
    filter: blur(24px);
  }

  .story-content h2 {
    margin-bottom: 20px;
  }

  .story-content p {
    color: var(--charcoal-gray);
    margin-bottom: 16px;
  }

  /* Team gallery */
  .team-gallery {
    padding: 0 0 var(--section-gap);
  }

  .team-gallery-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
  }

  .team-gallery-item {
    border-radius: var(--radius-brand);
    overflow: hidden;
    box-shadow: var(--shadow-card);
  }

  .team-gallery-img {
    width: 100%;
    height: 320px;
    object-fit: cover;
    display: block;
  }

  /* Values Section */
  .values-section {
    background:
      radial-gradient(ellipse at 20% 80%, rgba(186, 218, 144, 0.06) 0%, transparent 50%),
      radial-gradient(ellipse at 80% 30%, rgba(141, 216, 236, 0.04) 0%, transparent 50%),
      var(--cream);
  }

  .values-header {
    text-align: center;
    margin-bottom: 48px;
  }

  .values-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }

  .value-card {
    background-color: var(--cream);
    border: 1px solid rgba(186, 168, 152, 0.3);
    border-radius: var(--radius-brand);
    padding: 32px 24px;
    box-shadow: var(--shadow-card);
    transition: box-shadow 0.3s ease, transform 0.3s ease;
  }

  .value-card:hover {
    box-shadow: var(--shadow-card-hover);
    transform: translateY(-4px);
  }

  .value-icon {
    width: 52px;
    height: 52px;
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 16px;
  }

  .value-card h3 {
    font-family: var(--font-display);
    font-size: 1.15rem;
    margin-bottom: 8px;
  }

  .value-card p {
    font-size: 0.875rem;
    color: var(--charcoal-gray);
    line-height: 1.65;
  }

  /* CTA Banner */
  .cta-banner {
    background:
      radial-gradient(ellipse at 50% 50%, rgba(242, 196, 162, 0.06) 0%, transparent 50%),
      var(--cream-peach);
    padding: 64px 0;
  }

  .cta-content {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
  }

  .cta-content p {
    color: var(--charcoal-gray);
    margin-bottom: 8px;
  }

  @media (max-width: 768px) {
    .story-grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .team-gallery-grid {
      grid-template-columns: 1fr;
    }

    .team-gallery-img {
      height: 240px;
    }

    .values-grid {
      grid-template-columns: 1fr 1fr;
      gap: 16px;
    }

    .team-gallery {
      padding-bottom: var(--section-gap-mobile);
    }
  }

  @media (max-width: 480px) {
    .values-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .value-card {
      transition: none;
    }
    .value-card:hover {
      transform: none;
    }
  }
</style>
