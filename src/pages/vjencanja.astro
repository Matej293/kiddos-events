---
import Layout from "../layouts/Layout.astro";
import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer.astro";
import { Image } from "astro:assets";
import vjencanjaMain from "../assets/sections/vjencanja-main.jpeg";
import heroVjencanja from "../assets/home/hero-vjencanja.jpeg";
import hr from "../i18n/hr";

const t = hr;
const basePath = "";
---

<Layout
  title={t.meta.weddings.title}
  description={t.meta.weddings.description}
  locale={t.locale}
  language={t.lang}
  t={t}
  basePath={basePath}
>
  <Navigation t={t} basePath={basePath} />

  <main class="story-page">
    <section class="section split-section split-hero match-text">
      <div class="container split-grid split-hero-grid">
        <div class="intro-title-wrap reveal" style="--reveal-delay: 0s;">
          <p class="intro-title">{t.weddings.heroTitle}</p>
        </div>
        <div class="split-text reveal" style="--reveal-delay: 0.05s;">
          <h1 class="intro-subtitle">
            {t.weddings.heroSubtitle.split("\n").map((line, index) => (
              <>{line}{index === 0 ? <br /> : null}</>
            ))}
          </h1>
          {t.weddings.heroParagraphs.map((text) => (
            <p set:html={text}/>
          ))}
        </div>
        <div
          class="split-media reveal"
          style="--reveal-delay: 0.15s; --crop-x: 50%; --crop-y: 60%; --media-max: 520px; --media-ratio: 3 / 4;"
        >
          <div class="img-wrap frame frame--soft">
            <Image
              src={vjencanjaMain}
              alt={t.weddings.altMain}
              width={1800}
              loading="eager"
              decoding="async"
              priority
              sizes="(max-width: 900px) 100vw, 48vw"
              class="media-image"
            />
          </div>
        </div>
      </div>
    </section>

    <section class="section split-section split-reverse crop-top match-text">
      <div class="container split-grid with-cta">
        <div class="split-text reveal" style="--reveal-delay: 0.1s;">
          {t.weddings.detailsParagraphs.map((text) => (
            <p set:html={text} />
          ))}
        </div>
        <div class="split-cta reveal" style="--reveal-delay: 0.16s;">
          <button type="button" class="btn-primary" data-contact-open>
            {t.weddings.cta}
          </button>
        </div>
        <div
          class="split-media reveal"
          style="--reveal-delay: 0.2s; --crop-x: 50%; --crop-y: 60%; --media-max: 520px; --media-ratio: 4 / 3;"
        >
          <div class="img-wrap frame frame--sharp">
            <Image
              src={heroVjencanja}
              alt={t.weddings.altHero}
              width={1600}
              loading="lazy"
              decoding="async"
              fetchpriority="low"
              sizes="(max-width: 900px) 100vw, 46vw"
              class="media-image"
            />
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer t={t} basePath={basePath} />

  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Service",
      name: t.weddings.heroTitle,
      description: t.meta.weddings.description,
      provider: {
        "@type": "LocalBusiness",
        name: "Kiddos Events",
        url: "https://kiddos-events.hr",
        telephone: "+385991234567",
        address: {
          "@type": "PostalAddress",
          addressLocality: "Osijek",
          addressCountry: "HR",
        },
      },
      areaServed: "HR",
    })}
  />
</Layout>

<style>
  .split-hero .intro-subtitle {
    max-width: 18ch;
  }
</style>
