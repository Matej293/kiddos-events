---
import Layout from "../../layouts/Layout.astro";
import Navigation from "../../components/Navigation.astro";
import Footer from "../../components/Footer.astro";
import en from "../../i18n/en";

const t = en;
const basePath = "/en";
---

<Layout
  title={t.meta.terms.title}
  description={t.meta.terms.description}
  locale={t.locale}
  language={t.lang}
  t={t}
  basePath={basePath}
>
  <Navigation t={t} basePath={basePath} />
  <main>
    <section class="legal-hero">
      <div class="container">
        <p class="legal-eyebrow">{t.legal.eyebrow}</p>
        <h1>{t.legal.terms.heading}</h1>
        <p class="legal-meta">{t.legal.company}</p>
      </div>
    </section>

    <section class="legal-content section">
      <div class="container legal-body">
        {t.legal.terms.sections.map((section: { title: string; paragraphs?: readonly string[]; list?: readonly string[]; email?: string; emailSuffix?: string }) => (
          <section>
            <h2>{section.title}</h2>
            {section.paragraphs?.map((text: string, paragraphIndex: number) => (
              <p>
                {text}
                {section.email && paragraphIndex === 0 ? (
                  <>
                    {" "}
                    <a href={`mailto:${section.email}`}>{section.email}</a>
                    {section.emailSuffix ?? ""}
                  </>
                ) : null}
              </p>
            ))}
            {section.list ? (
              <ul>
                {section.list.map((item: string) => (
                  <li>{item}</li>
                ))}
              </ul>
            ) : null}
          </section>
        ))}
      </div>
    </section>
  </main>
  <Footer t={t} basePath={basePath} />
</Layout>

<style>
  .legal-hero {
    padding: calc(var(--section-gap-desktop) + 32px) 0 56px;
    background: var(--paper);
    border-bottom: 1px solid rgba(44, 44, 44, 0.08);
  }

  .legal-eyebrow {
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-weight: 600;
    color: var(--dark);
    margin-bottom: 20px;
    max-width: none;
  }

  .legal-hero h1 {
    font-size: clamp(1.95rem, 3.7vw, 3rem);
    font-weight: 600;
    margin-bottom: 12px;
    max-width: 720px;
  }

  .legal-meta {
    font-size: 0.94rem;
    color: rgba(44, 44, 44, 0.6);
    max-width: none;
  }

  .legal-content {
    background: var(--paper);
  }

  .legal-body {
    max-width: 760px;
    font-size: 1.04rem;
    line-height: 1.8;
    color: var(--charcoal-gray);
  }

  .legal-body h2 {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--dark);
    margin-top: 40px;
    margin-bottom: 12px;
  }

  .legal-body h3 {
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--dark);
    margin-top: 28px;
    margin-bottom: 8px;
  }

  .legal-body p {
    margin-bottom: 16px;
  }

  .legal-body ul,
  .legal-body ol {
    padding-left: 24px;
    margin-bottom: 16px;
  }

  .legal-body li {
    margin-bottom: 6px;
  }

  @media (max-width: 768px) {
    .legal-hero {
      padding-top: calc(var(--section-gap-mobile) + var(--nav-clearance-mobile));
    }
  }
</style>
