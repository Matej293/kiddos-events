---
import Layout from "../../layouts/Layout.astro";
import Navigation from "../../components/Navigation.astro";
import HeroCarousel from "../../components/HeroCarousel.astro";
import Footer from "../../components/Footer.astro";
import en from "../../i18n/en";

const t = en;
const basePath = "/en";
const buildPath = (path: string) => (path === "/" ? basePath : `${basePath}${path}`);
---

<Layout
  title={t.meta.home.title}
  description={t.meta.home.description}
  locale={t.locale}
  language={t.lang}
  t={t}
  basePath={basePath}
>
  <Navigation t={t} basePath={basePath} />

  <main>
    <HeroCarousel t={t} basePath={basePath} />

    <section class="section intro">
      <div class="container intro-shell">
        <div class="intro-panel">
          <div class="intro-inner">
            <p class="intro-kicker">{t.index.intro.kicker}</p>
            <h1>{t.index.intro.title}</h1>
            <p>{t.index.intro.body}</p>
          </div>
          <div class="intro-tags" aria-label={t.index.intro.tagsLabel}>
            {t.index.intro.tags.map((tag) => (
              <span>{tag}</span>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="section services">
      <div class="container services-inner">
        <div class="services-header">
          <p class="eyebrow">{t.index.services.eyebrow}</p>
          <h2>{t.index.services.title}</h2>
          <p>{t.index.services.body}</p>
        </div>

        <div class="services-grid">
          <a class="service-card" href={buildPath("/vjencanja")}>
            <h3>{t.index.services.cards.weddings.title}</h3>
            <p>{t.index.services.cards.weddings.body}</p>
            <span class="service-link">
              <span class="service-text">{t.index.services.linkText}</span>
              <span class="service-arrow" aria-hidden="true">›</span>
            </span>
          </a>

          <a class="service-card" href={buildPath("/proslave-i-eventi")}>
            <h3>{t.index.services.cards.events.title}</h3>
            <p>{t.index.services.cards.events.body}</p>
            <span class="service-link">
              <span class="service-text">{t.index.services.linkText}</span>
              <span class="service-arrow" aria-hidden="true">›</span>
            </span>
          </a>

          <a class="service-card" href={buildPath("/najam-opreme")}>
            <h3>{t.index.services.cards.rental.title}</h3>
            <p>{t.index.services.cards.rental.body}</p>
            <span class="service-link">
              <span class="service-text">{t.index.services.linkText}</span>
              <span class="service-arrow" aria-hidden="true">›</span>
            </span>
          </a>
        </div>
      </div>
    </section>

    <div class="container section-divider" aria-hidden="true">
      <span class="divider-line"></span>
      <span class="divider-block"></span>
      <span class="divider-block"></span>
      <span class="divider-block"></span>
      <span class="divider-line"></span>
    </div>

    <section class="section reviews-section">
      <div class="container reviews-inner">
        <div class="reviews-header">
          <h2>{t.index.reviews.title}</h2>
          <p class="reviews-subtitle">{t.index.reviews.subtitle}</p>
        </div>

        <div class="reviews-grid">
          {t.index.reviews.items.map((review) => (
            <article class="review-card">
              <div class="review-stars" aria-label={`${review.rating} out of 5`}>
                {Array.from({ length: 5 }).map((_, i) => (
                  <svg width="16" height="16" viewBox="0 0 24 24" fill={i < review.rating ? "var(--taupe)" : "none"} stroke="var(--taupe)" stroke-width="1.5" aria-hidden="true">
                    <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
                  </svg>
                ))}
              </div>
              <p class="review-text">{review.text}</p>
              <div class="review-footer">
                <span class="review-name">{review.name}</span>
                <span class="review-source">{t.index.reviews.googleLabel}</span>
              </div>
            </article>
          ))}
        </div>

        <div class="reviews-cta">
          <a
            href="https://maps.google.com/?cid=0xa3eb1036fe885e5f:0x3cf45dc05acb15bf"
            target="_blank"
            rel="noopener noreferrer"
            class="btn-primary"
          >
            {t.index.reviews.cta}
          </a>
        </div>
      </div>
    </section>

    <section class="section social-section">
      <div class="container social-inner">
        <div class="social-copy">
          <p class="eyebrow">{t.index.social.eyebrow}</p>
          <h2>{t.index.social.title}</h2>
          <p>{t.index.social.body}</p>
        </div>

        <div class="social-actions">
          <a
            href="https://instagram.com/kiddosevents"
            target="_blank"
            rel="noopener noreferrer"
            class="btn-secondary social-btn social-btn--compact"
            aria-label={t.index.social.aria.instagram}
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
              <circle cx="12" cy="12" r="4"></circle>
              <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"></circle>
            </svg>
            {t.index.social.labels.instagram}
          </a>
          <a
            href="https://www.facebook.com/profile.php?id=61566598790046"
            target="_blank"
            rel="noopener noreferrer"
            class="btn-secondary social-btn social-btn--compact"
            aria-label={t.index.social.aria.facebook}
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path>
            </svg>
            {t.index.social.labels.facebook}
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer t={t} basePath={basePath} />

  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "LocalBusiness",
      name: "Kiddos Events",
      description: t.meta.home.jsonLdDescription,
      url: "https://kiddos-events.hr",
      telephone: "+385991234567",
      address: {
        "@type": "PostalAddress",
        addressLocality: "Osijek",
        addressCountry: "HR",
      },
      openingHours: "Mo-Fr 09:00-18:00",
      image: "https://kiddos-events.hr/og-image.jpg",
    })}
  />
</Layout>

<style>
  .intro {
    padding-top: clamp(60px, 7vw, 80px);
  }

  .intro-shell {
    position: relative;
  }

  .intro-panel {
    margin-top: 36px;
    background: var(--paper);
    border: 1px solid rgba(44, 44, 44, 0.12);
    border-radius: 12px;
    box-shadow: 0 20px 50px rgba(44, 44, 44, 0.12);
    padding: 32px 36px;
    display: grid;
    gap: 24px;
  }

  .intro-kicker {
    font-size: 0.78rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    font-weight: 600;
    color: var(--charcoal-gray);
    margin-bottom: 6px;
  }

  .intro-inner {
    display: grid;
    gap: 20px;
    align-content: start;
  }

  .intro-inner h1 {
    max-width: 18ch;
  }

  .intro-inner p {
    max-width: 70ch;
    color: var(--charcoal-gray);
  }

  .intro-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .intro-tags span {
    display: inline-flex;
    align-items: center;
    padding: 6px 12px;
    border-radius: 999px;
    border: 1px solid rgba(44, 44, 44, 0.18);
    font-size: 0.84rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--dark);
  }

  .services {
    padding-top: 0;
  }

  .services-inner {
    display: grid;
    gap: 36px;
  }

  .services-header {
    display: grid;
    gap: 16px;
    max-width: 60ch;
  }

  .services-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 24px;
  }

  .service-card {
    display: grid;
    background: var(--paper);
    border: 1px solid rgba(44, 44, 44, 0.12);
    border-radius: 10px;
    padding: 28px 26px;
    gap: 14px;
    box-shadow: 0 14px 32px rgba(44, 44, 44, 0.08);
    color: inherit;
    text-decoration: none;
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
  }

  .service-card:hover,
  .service-card:focus-visible {
    transform: translateY(-2px);
    border-color: rgba(44, 44, 44, 0.18);
    box-shadow: 0 18px 36px rgba(44, 44, 44, 0.12);
  }

  .service-card:focus-visible {
    outline: 2px solid var(--dark);
    outline-offset: 4px;
  }

  .service-card h3 {
    font-size: 1.2rem;
  }

  .service-card p {
    color: var(--charcoal-gray);
    max-width: none;
  }

  .service-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-weight: 600;
    color: var(--dark);
    letter-spacing: 0.01em;
    transition: color 0.2s ease, opacity 0.2s ease;
  }

  .service-arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 1.35rem;
    line-height: 1;
  }

  .service-card:hover .service-link,
  .service-card:focus-visible .service-link {
    color: #000;
    opacity: 0.8;
  }

  .service-card:hover .service-text,
  .service-card:focus-visible .service-text {
    text-decoration-line: underline;
    text-underline-offset: 3px;
  }

  .social-section {
    padding-top: 0;
  }

  .reviews-section {
    padding-top: 0;
  }

  .reviews-inner {
    display: grid;
    gap: 36px;
  }

  .reviews-header {
    text-align: center;
    display: grid;
    gap: 8px;
    justify-items: center;
  }

  .reviews-subtitle {
    font-size: 0.85rem;
    color: var(--charcoal-gray);
    letter-spacing: 0.02em;
  }

  .reviews-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .review-card {
    display: grid;
    gap: 16px;
    background: var(--paper);
    border: 1px solid rgba(44, 44, 44, 0.12);
    border-radius: 10px;
    padding: 28px 26px;
    box-shadow: 0 14px 32px rgba(44, 44, 44, 0.08);
    align-content: start;
  }

  .review-stars {
    display: flex;
    gap: 2px;
  }

  .review-text {
    color: var(--charcoal-gray);
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
    line-height: 1.6;
  }

  .review-footer {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: auto;
  }

  .review-name {
    font-weight: 600;
    font-size: 0.92rem;
    color: var(--dark);
  }

  .review-source {
    font-size: 0.75rem;
    color: var(--charcoal-gray);
    padding: 2px 8px;
    border-radius: 4px;
    background: rgba(44, 44, 44, 0.06);
  }

  .reviews-cta {
    display: flex;
    justify-content: center;
  }

  .section-divider {
    display: flex;
    align-items: center;
    gap: 10px;
    padding-bottom: 28px;
  }

  .divider-line {
    flex: 1;
    height: 1px;
    background: rgba(44, 44, 44, 0.18);
  }

  .divider-block {
    width: 10px;
    height: 10px;
    background: rgba(44, 44, 44, 0.45);
  }

  .social-inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 16px;
    align-items: center;
    background: rgba(186, 168, 152, 0.12);
    border: 1px solid rgba(44, 44, 44, 0.1);
    border-radius: 12px;
    padding: 36px 40px;
  }

  .social-copy {
    display: grid;
    gap: 16px;
  }

  .social-copy p {
    max-width: none;
  }

  .social-actions {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    gap: 12px;
    align-items: flex-start;
    align-self: center;
    justify-self: start;
  }

  .social-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .social-btn--compact {
    padding: 8px 12px;
    font-size: 0.8rem;
    border-radius: 6px;
    font-weight: 600;
  }

  @media (max-width: 768px) {
    .intro-panel {
      margin-top: -40px;
      padding: 24px 20px;
    }

    .intro-inner {
      gap: 16px;
    }

    .services-inner {
      gap: 24px;
    }

    .services-grid {
      grid-template-columns: 1fr;
    }

    .reviews-grid {
      grid-template-columns: 1fr;
    }

    .review-card {
      padding: 22px 20px;
    }

    .social-inner {
      grid-template-columns: 1fr;
      padding: 28px 22px;
    }

    .social-actions {
      width: 100%;
    }

    .social-btn,
    .social-btn--compact {
      width: 100%;
      justify-content: center;
    }
  }

  @media (max-width: 1024px) {
    .services-grid {
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    }
  }
</style>
